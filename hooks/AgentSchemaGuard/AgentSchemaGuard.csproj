<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AgentSchemaGuard</AssemblyName>
    <!-- Lets `dotnet publish` produce a single self-contained exe if you want
         to register the binary path directly instead of `dotnet run`. -->
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

</Project>
