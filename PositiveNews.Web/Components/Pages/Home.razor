@page "/"

<PageTitle>PositiveNews</PageTitle>

<div class="home-layout">
    <main class="home-layout__main">
        @if (Stories.Count == 0)
        {
            <p class="home-layout__empty">
                No curated stories yet — run <code>dotnet run --project PositiveNews.Cli -- run-pipeline</code>
                to populate some.
            </p>
        }
        else
        {
            @if (FilteredStories.Count == 0)
            {
                <p class="home-layout__empty">No stories match "@SearchQuery".</p>
            }
            else
            {
                @foreach (var story in FilteredStories)
                {
                    <ArticleCard @key="story.Id" Story="story" />
                }
            }

            @if (_hasMore)
            {
                <div @ref="_sentinel" class="home-layout__sentinel">
                    @if (_isLoadingMore)
                    {
                        <span>Loading more stories…</span>
                    }
                </div>
            }
            else
            {
                <p class="home-layout__end">You've reached the end — that's all the curated stories so far.</p>
            }
        }
    </main>

    <Sidebar TopRatedStories="TopRatedStories" @bind-SearchQuery="SearchQuery" />
</div>
