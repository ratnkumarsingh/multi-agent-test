<aside class="sidebar">
    <SearchBox Query="@SearchQuery" QueryChanged="HandleQueryChanged" />

    <SidebarSection Heading="Top Rated">
        <div class="sidebar__top-rated-list">
            @foreach (var story in TopRatedStories)
            {
                <TopRatedItem @key="story.Id" Story="story" />
            }
        </div>
    </SidebarSection>
</aside>
