<article class="article-card">
    <StoryAvatar ImageUrl="@Story.ImageUrl" Seed="@Story.Headline" Size="StoryAvatarSize.Large" />

    <div class="article-card__body">
        <h2 class="article-card__title"><a href="@StoryHref">@Story.Headline</a></h2>

        <div class="article-card__meta">
            <MetaItem Kind="IconKind.Calendar" Text="@PublishedLabel" />
            <MetaItem Kind="IconKind.Folder" Text="@Story.Source" />
            <MetaItem Kind="IconKind.Star" Text="@($"{Story.Score}/10")" />
        </div>

        <p class="article-card__excerpt">@Story.Body</p>

        <ReadMoreLink Href="@StoryHref" />
    </div>
</article>
